{
	"name": "chris-vaillancourt-website",
	"version": "0.0.1",
	"description": "Chris Vaillancourt's personal website.",
	"type": "module",
	"packageManager": "pnpm@10.29.2",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "astro check --watch & astro dev --host",
		"start": "astro dev",
		"build": "astro check && tsc --noEmit && pnpm format && astro build",
		"wrangler": "wrangler",
		"deploy": "wrangler pages deploy dist",
		"preview": "astro preview --host",
		"preview:wrangler": "wrangler pages dev ./dist",
		"astro": "astro",
		"tsc": "tsc",
		"test": "vitest",
		"test:e2e": "playwright test",
		"format": "prettier . --check --ignore-path=.prettierignore --ignore-path=.gitignore --plugin=prettier-plugin-astro",
		"format:fix": "pnpm format --write"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.6",
		"@astrojs/mdx": "^4.3.13",
		"@astrojs/sitemap": "^3.7.0",
		"@playwright/test": "^1.58.2",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.1.18",
		"@types/node": "^24.0.0",
		"daisyui": "^5.5.18",
		"prettier": "3.8.1",
		"prettier-plugin-astro": "^0.14.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"tailwindcss": "^4.1.18",
		"typescript": "^5.9.3",
		"vitest": "^4.0.18",
		"wrangler": "^4.65.0"
	},
	"dependencies": {
		"@astrojs/rss": "^4.0.15",
		"@gotedo/satori-html": "^0.3.4",
		"@mdi/js": "^7.4.47",
		"astro": "^5.17.2",
		"rehype-unwrap-images": "^1.0.0",
		"satori": "^0.18.4",
		"sharp": "^0.34.5",
		"zod": "^3.24.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"sharp"
		]
	}
}
